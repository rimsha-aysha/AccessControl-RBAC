# ---------------------------------------------------------------------------
# Backend configuration. Copy this file to ".env" and fill in real values.
# NEVER commit the .env file - it is listed in .gitignore.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=5050

# MongoDB connection string and a database used ONLY for this assignment.
# Local example below. For MongoDB Atlas use: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=rbac_access_control

# Secret used to sign login tokens. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend URL(s) allowed to call the API (comma separated, no trailing slash).
CORS_ORIGIN=http://localhost:5180

# --- First System Administrator (used only by: npm run setup:admin) ---------
# The script creates this user if the email does not exist yet. It never resets an existing password.
# Password: at least 12 characters with upper-case, lower-case letters and a number.
# You can delete ADMIN_PASSWORD from .env after the admin has been created.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Demo data (used only by: npm run seed) ---------------------------------
# Set to false to skip creating demo staff users.
SEED_DEMO_USERS=true
# Optional. If set, demo staff users (e.g. anita.menon@demo.local) can sign in with this password,
# which is useful for testing non-admin access. Leave empty to disable their sign-in.
DEMO_USER_PASSWORD=
