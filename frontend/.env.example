# Base URL of the backend API, ending in /api (not /api/health). Vite only exposes variables that start with VITE_.
# These values are PUBLIC (bundled into the browser code) - never put secrets here.
# Local development:
VITE_API_URL=http://localhost:5050/api
# Production (set this in your hosting dashboard, e.g. Vercel, then redeploy):
# VITE_API_URL=https://<your-backend-service>.onrender.com/api
